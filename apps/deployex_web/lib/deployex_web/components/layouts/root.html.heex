<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />

    <.live_title suffix=" · Monitoring Beam Apps">
      {assigns[:page_title] || "Deployex"}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
    <script>
      // Applies the theme and the sidebar state before the first paint. Both live on <html>, which
      // LiveView does not patch, so they survive live navigation.
      (() => {
        const html = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");

        // Storage can be blocked, like with site data off. The page then keeps the choices in memory, so the
        // switch and the sidebar still work, only not across a reload
        const saved = {};
        const load = (key) => {
          try {
            saved[key] = localStorage.getItem(key);
          } catch (_e) {
            saved[key] = null;
          }
        };
        const save = (key, value) => {
          saved[key] = value;
          try {
            if (value === null) localStorage.removeItem(key);
            else localStorage.setItem(key, value);
          } catch (_e) {}
        };
        load("phx:theme");
        load("dx:sidebar");

        // data-theme holds the theme: the one the user picked, or the system's until they pick one
        const applyTheme = () => {
          html.dataset.theme = saved["phx:theme"] || (systemDark.matches ? "dark" : "light");
        };

        const applySidebar = () => {
          if (saved["dx:sidebar"] === "collapsed") {
            html.dataset.sidebar = "collapsed";
          } else {
            delete html.dataset.sidebar;
          }
        };

        // The ShellState hook in app.js mirrors these into the aria state of the shell controls
        const changed = () => window.dispatchEvent(new Event("dx:shell-state"));

        applyTheme();
        applySidebar();

        window.addEventListener("dx:toggle-theme", () => {
          save("phx:theme", html.dataset.theme === "dark" ? "light" : "dark");
          applyTheme();
          changed();
        });

        window.addEventListener("dx:toggle-sidebar", () => {
          save("dx:sidebar", html.dataset.sidebar === "collapsed" ? null : "collapsed");
          applySidebar();
          changed();
        });

        // Another tab changed a choice
        window.addEventListener("storage", (e) => {
          if (e.key !== "phx:theme" && e.key !== "dx:sidebar") return;
          saved[e.key] = e.newValue;
          applyTheme();
          applySidebar();
          changed();
        });

        systemDark.addEventListener("change", () => {
          applyTheme();
          changed();
        });
      })();
    </script>
  </head>
  <body class="bg-base-200 antialiased">
    {@inner_content}
  </body>
</html>
